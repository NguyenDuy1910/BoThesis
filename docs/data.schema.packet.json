{
  "schema_version": 3,
  "title": "BoThesis canonical Item and storage ownership",
  "status": "implemented",
  "ownership": {
    "postgresql": "durable business and application state",
    "object_storage": "original binary source truth",
    "docling": "document understanding, normalization, chunking, and provenance",
    "qdrant": "derived contextual retrieval projection",
    "knowledge": "permission filtering, retrieval, reranking, and evidence",
    "agent": "reasoning over grounded evidence"
  },
  "source_entities": {
    "items": ["collection", "document", "file"],
    "hierarchy": "parent_item_id",
    "object_metadata": ["storage_key", "mime_type", "size_bytes", "content_sha256"],
    "retrieval_acl": ["allowed_principal_tokens", "denied_principal_tokens"],
    "lifecycle": ["pending", "processing", "ready", "failed", "unsupported", "deleted"]
  },
  "connector_entities": {
    "connectors": "configured connection instances",
    "connector_credentials": "connector-bound authenticated-encryption payloads",
    "connector_scopes": "independently checkpointed synchronization units",
    "sync_runs": "operational history and counters"
  },
  "chat_entities": {
    "message_items": ["attachment", "reference", "output"]
  },
  "forbidden_persistence": [
    "raw bytes in PostgreSQL",
    "processed chunks in PostgreSQL",
    "presigned URLs",
    "plaintext connector credentials",
    "generation-based index state"
  ],
  "initialization": "make init rebuilds PostgreSQL and Qdrant directly; no migrations"
}
