OPENROUTER_API_KEY=
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1

## Qdrant document index
# Leave empty for a local Qdrant instance without authentication.
QDRANT_URL=https://qdrant.bodangdiet.org
QDRANT_API_KEY=bothesis
QDRANT_COLLECTION=bothesis
QDRANT_PREFER_GRPC=false
EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_MODEL=openai/gpt-5.4-mini
BOTHESIS_MAX_MODEL_TURNS=3
BOTHESIS_MAX_TOOL_ROUNDS=2
BOTHESIS_MAX_TOOL_CALLS=6
BOTHESIS_TOOL_TIMEOUT_SECONDS=8
BOTHESIS_MAX_HISTORY_MESSAGES=24
BOTHESIS_MAX_HISTORY_CHARACTERS=24000
BOTHESIS_RECENT_HISTORY_MESSAGES=6
BOTHESIS_HISTORY_COMPRESSION_THRESHOLD=4000
BOTHESIS_MAX_COMPRESSED_HISTORY_CHARACTERS=2000

## Conversation attachments (S3, R2, MinIO, or another SigV4-compatible store)
BOTHESIS_OBJECT_STORAGE_ENDPOINT=
BOTHESIS_OBJECT_STORAGE_BUCKET=
BOTHESIS_OBJECT_STORAGE_ACCESS_KEY=
BOTHESIS_OBJECT_STORAGE_SECRET_KEY=
BOTHESIS_OBJECT_STORAGE_REGION=us-east-1
BOTHESIS_OBJECT_STORAGE_PATH_STYLE=true
BOTHESIS_ATTACHMENT_DATABASE=/tmp/bothesis-attachments.sqlite3
BOTHESIS_ATTACHMENT_MAX_UPLOAD_BYTES=20971520
BOTHESIS_ATTACHMENT_TIMEOUT_SECONDS=20
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
OTEL_SERVICE_NAME=bothesis-api
