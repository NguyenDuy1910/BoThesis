## OpenAI chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

## OpenRouter embeddings
OPENROUTER_API_KEY=
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
DATABASE_URL=postgresql+asyncpg://bothesis:bothesis@127.0.0.1:5432/bothesis

## Qdrant document index
# Leave empty for a local Qdrant instance without authentication.
QDRANT_URL=https://qdrant.bodangdiet.org
QDRANT_API_KEY=bothesis
QDRANT_COLLECTION=bothesis
# Boolean settings must use JSON boolean values.
QDRANT_PREFER_GRPC=false
EMBEDDING_MODEL=openai/text-embedding-3-small
# Phase 1 only: lets development admins query legacy points without tenant IDs.
# Requires BOTHESIS_ALLOW_INSECURE_DEV_IDENTITY=true.
BOTHESIS_PHASE1_UNSCOPED_RETRIEVAL=false
BOTHESIS_MAX_MODEL_TURNS=3
BOTHESIS_MAX_TOOL_ROUNDS=2
BOTHESIS_MAX_TOOL_CALLS=6
BOTHESIS_TOOL_TIMEOUT_SECONDS=8
BOTHESIS_MAX_HISTORY_MESSAGES=24
BOTHESIS_MAX_HISTORY_CHARACTERS=24000
BOTHESIS_RECENT_HISTORY_MESSAGES=6

## Chat document uploads (AWS S3 or Cloudflare R2)
# Supported values: aws_s3 (default), cloudflare_r2.
BOTHESIS_OBJECT_STORAGE_PROVIDER=aws_s3

### AWS S3
# Credentials use the standard AWS chain: environment, AWS_PROFILE/shared
# ~/.aws files, container credentials, or an instance role.
BOTHESIS_S3_BUCKET=
BOTHESIS_S3_REGION=us-east-1
BOTHESIS_S3_ENDPOINT_URL=
BOTHESIS_S3_ADDRESSING_STYLE=auto
BOTHESIS_S3_TIMEOUT_SECONDS=20
BOTHESIS_S3_MAX_POOL_CONNECTIONS=20

### Cloudflare R2
# Use an R2 API token's Access Key ID and Secret Access Key. The endpoint is
# derived from the account ID unless BOTHESIS_R2_ENDPOINT_URL is set.
BOTHESIS_R2_BUCKET=
BOTHESIS_R2_ACCOUNT_ID=
BOTHESIS_R2_ENDPOINT_URL=
BOTHESIS_R2_ACCESS_KEY_ID=
BOTHESIS_R2_SECRET_ACCESS_KEY=
BOTHESIS_R2_TIMEOUT_SECONDS=20
BOTHESIS_R2_MAX_POOL_CONNECTIONS=20

BOTHESIS_DOCUMENT_MAX_UPLOAD_BYTES=104857600
BOTHESIS_DOCUMENT_MAX_DATABASE_BLOB_BYTES=20971520
BOTHESIS_DOCUMENT_DIRECT_MAX_BYTES=20971520
BOTHESIS_DOCUMENT_MAX_PROCESSING_BYTES=104857600
BOTHESIS_DOCUMENT_UPLOAD_URL_SECONDS=600
BOTHESIS_DOCUMENT_RETRIEVAL_LIMIT=6
BOTHESIS_DOCUMENT_EMBEDDING_BATCH_SIZE=32
BOTHESIS_DOCUMENT_DOWNLOAD_URL_SECONDS=300

# Never enable this in production. Production injects AuthContext from trusted
# authentication middleware; the development mode only resolves these UUIDs
# against active users and database tenant memberships.
BOTHESIS_ALLOW_INSECURE_DEV_IDENTITY=true
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
OTEL_SERVICE_NAME=bothesis-api
