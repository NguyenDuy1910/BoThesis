BOTHESIS_MAX_RETRIEVAL_ROUNDS=2
BOTHESIS_MAX_RETRIEVAL_QUERIES=3
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
OTEL_SERVICE_NAME=bothesis-api
