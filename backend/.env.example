## OpenAI chat
OPENAI_API_KEY=
BOTHESIS_HOST=127.0.0.1
OPENAI_MODEL=gpt-5-mini

## OpenRouter document vision and embeddings
OPENROUTER_API_KEY=
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5-mini
BOTHESIS_DOCLING_MODEL=qwen/qwen3-vl-30b-a3b-instruct
DATABASE_URL=postgresql+asyncpg://bothesis:bothesis@127.0.0.1:5432/bothesis

## Qdrant document index
# Leave empty for a local Qdrant instance without authentication.
QDRANT_URL=https://qdrant.bodangdiet.org
QDRANT_API_KEY=bothesis
QDRANT_COLLECTION=bothesis
# Boolean settings must use JSON boolean values.
QDRANT_PREFER_GRPC=false
EMBEDDING_MODEL=openai/text-embedding-3-small
BOTHESIS_CONTEXTUALIZATION_ENABLED=true
BOTHESIS_CONTEXTUALIZATION_MODEL=
BOTHESIS_RETRIEVAL_CANDIDATE_COUNT=20
BOTHESIS_FINAL_RETRIEVAL_TOP_K=6
BOTHESIS_RERANKING_ENABLED=true
BOTHESIS_RERANKER_MODEL=
BOTHESIS_RETRIEVAL_CONTEXT_CHARACTERS=8000
# A turn can contain several sampling requests and tool calls.
BOTHESIS_MAX_MODEL_TURNS=8
BOTHESIS_MAX_TOOL_ROUNDS=4
BOTHESIS_MAX_TOOL_CALLS=6
# Must stay above the slowest enabled tool's own budget so a tool can report
# its own outcome before the wrapper gives up on it.
BOTHESIS_TOOL_TIMEOUT_SECONDS=60
BOTHESIS_MAX_RESOURCE_READ_CHARACTERS=12000
BOTHESIS_MAX_HISTORY_MESSAGES=24
BOTHESIS_MAX_HISTORY_CHARACTERS=24000
BOTHESIS_RECENT_HISTORY_MESSAGES=6

## Conversation artifacts
BOTHESIS_ARTIFACT_MAX_CONTENT_BYTES=2097152
BOTHESIS_ARTIFACT_CONTEXT_CHARACTERS=20000
BOTHESIS_ARTIFACT_RESULT_CHARACTERS=8000
BOTHESIS_ARTIFACT_DOWNLOAD_URL_SECONDS=300

## Chat document uploads (AWS S3 or Cloudflare R2)
# Supported values: aws_s3 (default), cloudflare_r2.
BOTHESIS_OBJECT_STORAGE_PROVIDER=aws_s3
BOTHESIS_OBJECT_STORAGE_BUCKET=

### AWS S3
# Credentials use the standard AWS chain: environment, AWS_PROFILE/shared
# ~/.aws files, container credentials, or an instance role.
BOTHESIS_S3_BUCKET=
BOTHESIS_S3_REGION=us-east-1
BOTHESIS_S3_ENDPOINT_URL=
BOTHESIS_S3_ADDRESSING_STYLE=auto
BOTHESIS_S3_TIMEOUT_SECONDS=20
BOTHESIS_S3_MAX_POOL_CONNECTIONS=20

### Cloudflare R2
# Use an R2 API token's Access Key ID and Secret Access Key. The endpoint is
# derived from the account ID unless BOTHESIS_R2_ENDPOINT_URL is set.
BOTHESIS_R2_BUCKET=
BOTHESIS_R2_ACCOUNT_ID=
BOTHESIS_R2_ENDPOINT_URL=
BOTHESIS_R2_ACCESS_KEY_ID=
BOTHESIS_R2_SECRET_ACCESS_KEY=
BOTHESIS_R2_TIMEOUT_SECONDS=20
BOTHESIS_R2_MAX_POOL_CONNECTIONS=20

BOTHESIS_DOCUMENT_MAX_UPLOAD_BYTES=104857600
BOTHESIS_DOCUMENT_DIRECT_MAX_BYTES=20971520
BOTHESIS_DOCUMENT_MAX_PROCESSING_BYTES=104857600
BOTHESIS_DOCUMENT_UPLOAD_URL_SECONDS=600
BOTHESIS_DOCUMENT_RETRIEVAL_LIMIT=6
BOTHESIS_DOCUMENT_EMBEDDING_BATCH_SIZE=32
BOTHESIS_DOCUMENT_DOWNLOAD_URL_SECONDS=300

## Derived knowledge previews (original objects remain authoritative)
BOTHESIS_PREVIEW_MAX_SOURCE_BYTES=104857600
BOTHESIS_PREVIEW_MAX_PAGES=50
BOTHESIS_PREVIEW_MAX_DIMENSION=1600
BOTHESIS_PREVIEW_WEBP_QUALITY=80
BOTHESIS_PREVIEW_URL_SECONDS=300

## Local encrypted integration credentials
# URL-safe base64 encoding of exactly 32 random bytes.
# Generate once with: openssl rand -base64 32 | tr '+/' '-_'
BOTHESIS_INTEGRATION_ENCRYPTION_KEY=

## Temporal durable workflow runtime
BOTHESIS_TEMPORAL_TARGET=127.0.0.1:7233
BOTHESIS_TEMPORAL_NAMESPACE=default
BOTHESIS_TEMPORAL_TASK_QUEUE=bothesis-ingestion
BOTHESIS_TEMPORAL_API_KEY=
BOTHESIS_TEMPORAL_TLS=false
BOTHESIS_TEMPORAL_MAX_CONCURRENT_ACTIVITIES=4
# Optional task-queue-wide Activity starts per second for connector backpressure.
BOTHESIS_TEMPORAL_ACTIVITY_RATE_LIMIT=

# Keep this false outside intentional local debugging. When true, the API accepts
# explicit development UUID headers after checking active database memberships.
BOTHESIS_ALLOW_INSECURE_DEV_IDENTITY=false

## Internal access tokens
# Required for Google login completion and all Bearer authentication. Use at
# least 32 random bytes, for example: openssl rand -base64 48
BOTHESIS_AUTH_JWT_SECRET=
BOTHESIS_AUTH_JWT_ISSUER=bothesis
BOTHESIS_AUTH_JWT_AUDIENCE=bothesis-api
BOTHESIS_AUTH_JWT_EXPIRES_IN_SECONDS=900

## Google Identity Services
# This public OAuth client ID must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in web.
BOTHESIS_GOOGLE_CLIENT_ID=
BOTHESIS_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
OTEL_SERVICE_NAME=bothesis-api
