## Qdrant document index
# Copy to .env and use an empty API key only for an unauthenticated local instance.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bothesis_documents
QDRANT_PREFER_GRPC=false

# OpenRouter models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
