// BoThesis canonical knowledge architecture.
// PostgreSQL owns durable domain state. Raw bytes live in S3/R2. Retrieval
// chunks, embeddings, and BM25 representation live in Qdrant.

Table users {
  id uuid [pk]
  email varchar(255) [not null, unique]
  display_name varchar(255)
  status varchar(16) [not null, default: 'active']
  preferences jsonb [not null, default: `{}`]
  last_login_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table tenants {
  id uuid [pk]
  code varchar(64) [not null, unique]
  name varchar(255) [not null]
  status varchar(16) [not null, default: 'active']
  settings jsonb [not null, default: `{}`]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table roles {
  id uuid [pk]
  tenant_id uuid [not null]
  code varchar(64) [not null]
  display_name varchar(255) [not null]
  permission_codes text[] [not null]
  status varchar(16) [not null, default: 'active']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (tenant_id, code) [unique] }
}

Table tenant_memberships {
  user_id uuid [not null]
  tenant_id uuid [not null]
  role_id uuid [not null]
  status varchar(16) [not null, default: 'active']
  joined_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (user_id, tenant_id) [pk] }
}

Table groups {
  id uuid [pk]
  tenant_id uuid [not null]
  code varchar(64) [not null]
  display_name varchar(255) [not null]
  description text
  status varchar(16) [not null, default: 'active']
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (tenant_id, code) [unique] }
}

Table group_memberships {
  group_id uuid [not null]
  user_id uuid [not null]
  status varchar(16) [not null, default: 'active']
  joined_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (group_id, user_id) [pk] }
}

Table items {
  id uuid [pk]
  tenant_id uuid [not null]
  item_type varchar(16) [not null, note: 'collection | document']
  parent_item_id uuid
  parent_relation varchar(32) [note: 'contains | child | attachment | embedded']
  document_type varchar(64) [note: 'Required only for Documents; semantic, not provider identity']
  title text [not null]
  mime_type varchar(255)
  size_bytes bigint
  storage_key text [note: 'Durable object key only; no raw bytes']
  metadata jsonb [not null, default: `{}`]
  inherit_access boolean [not null, default: true]
  status varchar(16) [not null, note: 'pending | processing | ready | failed | unsupported | deleted']
  created_by_user_id uuid
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    tenant_id
    parent_item_id
    (tenant_id, status)
  }
  Note: 'Only Collections may be roots. Parent and parent_relation are both null or both set; self-parenting is rejected. Collection children are allowed only under Collections. Document children may be Documents. Database constraints/triggers enforce same-tenant parentage, prevent cycles, and reject Document -> Collection.'
}

Table collection_access {
  item_id uuid [not null, note: 'Must reference an Item with item_type=collection']
  principal_type varchar(16) [not null, note: 'user | group']
  principal_id uuid [not null]
  role varchar(16) [not null, note: 'owner | editor | viewer']
  created_by_user_id uuid
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (item_id, principal_type, principal_id) [pk]
    (principal_type, principal_id)
  }
}

Table item_uploads {
  item_id uuid [pk, note: 'Must reference a Document Item']
  tenant_id uuid [not null]
  owner_user_id uuid [not null]
  idempotency_key varchar(128) [not null]
  status varchar(16) [not null, note: 'pending | available | failed']
  error_code varchar(128)
  uploaded_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (tenant_id, owner_user_id, idempotency_key) [unique] }
}

Table message_items {
  message_id uuid [not null]
  item_id uuid [not null]
  relation_type varchar(16) [not null]
  position int [not null, default: 0]
  deleted_at timestamptz
  created_at timestamptz [not null]
  indexes { (message_id, item_id, relation_type) [pk] }
}

Table plugin_connections {
  id uuid [pk]
  tenant_id uuid [not null]
  plugin_key varchar(64) [not null]
  owner_type varchar(16) [not null, note: 'user | tenant']
  owner_user_id uuid
  display_name varchar(255) [not null]
  config jsonb [not null, default: `{}`, note: 'Non-secret connection/runtime configuration']
  status varchar(16) [not null, default: 'active']
  created_by_user_id uuid
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    tenant_id
    plugin_key
    owner_user_id
    (tenant_id, display_name) [unique]
  }
}

Table plugin_credentials {
  id uuid [pk]
  connection_id uuid [not null, unique]
  credential_type varchar(64) [not null]
  encrypted_payload text [not null]
  expires_at timestamptz
  key_version varchar(64)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table plugin_bindings {
  id uuid [pk]
  connection_id uuid [not null]
  target_item_id uuid [not null, note: 'Must reference an Item with item_type=collection']
  display_name varchar(255)
  config jsonb [not null, default: `{}`, note: 'Plugin-owned external scope']
  checkpoint jsonb [not null, default: `{}`]
  status varchar(16) [not null, default: 'active']
  last_synced_at timestamptz
  last_indexed_at timestamptz
  created_by_user_id uuid
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    connection_id
    target_item_id
  }
}

Table item_origins {
  id uuid [pk]
  item_id uuid [not null, note: 'Normally references a Document Item']
  binding_id uuid [not null]
  external_id text [not null]
  external_version text
  etag text
  external_updated_at timestamptz
  source_url text
  metadata jsonb [not null, default: `{}`]
  last_seen_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (binding_id, external_id) [unique]
    item_id
  }
}

Table conversations {
  id uuid [pk]
  tenant_id uuid [not null]
  user_id uuid [not null]
  title varchar(512)
  summary text
  summary_updated_at timestamptz
  state jsonb [not null, default: `{}`]
  status varchar(16) [not null, default: 'active']
  last_message_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table messages {
  id uuid [pk]
  conversation_id uuid [not null]
  role varchar(16) [not null]
  content text [not null]
  metadata jsonb [not null, default: `{}`]
  sequence_number bigint [not null]
  created_at timestamptz [not null]
  indexes { (conversation_id, sequence_number) [unique] }
}

Table memories {
  id uuid [pk]
  tenant_id uuid [not null]
  user_id uuid [not null]
  conversation_id uuid
  memory_type varchar(32) [not null]
  memory_key varchar(255)
  content text [not null]
  metadata jsonb [not null, default: `{}`]
  source_message_id uuid
  importance float
  confidence float
  status varchar(16) [not null, default: 'active']
  last_used_at timestamptz
  expires_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table access_requests {
  id uuid [pk]
  tenant_id uuid [not null]
  requester_user_id uuid [not null]
  collection_item_id uuid [not null]
  requested_role varchar(16) [not null, note: 'owner | editor | viewer']
  reason text
  status varchar(16) [not null, default: 'pending']
  reviewed_by_user_id uuid
  review_note text
  reviewed_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table audit_logs {
  id uuid [pk]
  tenant_id uuid [not null]
  actor_user_id uuid
  action varchar(96) [not null]
  resource_type varchar(32) [not null]
  resource_id varchar(512)
  outcome varchar(16) [not null]
  details jsonb [not null, default: `{}`]
  created_at timestamptz [not null]
}

Ref: roles.tenant_id > tenants.id
Ref: tenant_memberships.user_id > users.id
Ref: tenant_memberships.tenant_id > tenants.id
Ref: tenant_memberships.role_id > roles.id
Ref: groups.tenant_id > tenants.id
Ref: group_memberships.group_id > groups.id
Ref: group_memberships.user_id > users.id

Ref: items.tenant_id > tenants.id
Ref: items.parent_item_id > items.id
Ref: items.created_by_user_id > users.id
Ref: collection_access.item_id > items.id
Ref: collection_access.created_by_user_id > users.id
Ref: item_uploads.item_id - items.id
Ref: item_uploads.tenant_id > tenants.id
Ref: item_uploads.owner_user_id > users.id
Ref: message_items.message_id > messages.id
Ref: message_items.item_id > items.id

Ref: plugin_connections.tenant_id > tenants.id
Ref: plugin_connections.owner_user_id > users.id
Ref: plugin_connections.created_by_user_id > users.id
Ref: plugin_credentials.connection_id - plugin_connections.id
Ref: plugin_bindings.connection_id > plugin_connections.id
Ref: plugin_bindings.target_item_id > items.id
Ref: plugin_bindings.created_by_user_id > users.id
Ref: item_origins.item_id > items.id
Ref: item_origins.binding_id > plugin_bindings.id
Ref: conversations.tenant_id > tenants.id
Ref: conversations.user_id > users.id
Ref: messages.conversation_id > conversations.id
Ref: memories.tenant_id > tenants.id
Ref: memories.user_id > users.id
Ref: memories.conversation_id > conversations.id
Ref: memories.source_message_id > messages.id

Ref: access_requests.tenant_id > tenants.id
Ref: access_requests.requester_user_id > users.id
Ref: access_requests.collection_item_id > items.id
Ref: access_requests.reviewed_by_user_id > users.id
Ref: audit_logs.tenant_id > tenants.id
Ref: audit_logs.actor_user_id > users.id
