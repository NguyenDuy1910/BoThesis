// BoThesis initial database design.
// PostgreSQL owns durable business state only. Raw bytes are in S3/R2 and
// retrieval chunks are in Qdrant.

Table users {
  id uuid [pk]
  email varchar(255) [not null, unique]
  display_name varchar(255)
  status varchar(16) [not null, default: 'active']
  preferences jsonb [not null, default: `{}`]
  last_login_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table tenants {
  id uuid [pk]
  code varchar(64) [not null, unique]
  name varchar(255) [not null]
  status varchar(16) [not null, default: 'active']
  settings jsonb [not null, default: `{}`]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table roles {
  id uuid [pk]
  tenant_id uuid [not null]
  code varchar(64) [not null]
  display_name varchar(255) [not null]
  permission_codes text[] [not null]
  status varchar(16) [not null, default: 'active']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (tenant_id, code) [unique] }
}

Table tenant_memberships {
  user_id uuid [not null]
  tenant_id uuid [not null]
  role_id uuid [not null]
  status varchar(16) [not null, default: 'active']
  joined_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (user_id, tenant_id) [pk] }
}

Table conversations {
  id uuid [pk]
  user_id uuid [not null]
  title varchar(512)
  summary text
  summary_updated_at timestamptz
  state jsonb [not null, default: `{}`]
  status varchar(16) [not null, default: 'active']
  last_message_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table messages {
  id uuid [pk]
  conversation_id uuid [not null]
  role varchar(16) [not null]
  content text [not null]
  metadata jsonb [not null, default: `{}`]
  sequence_number bigint [not null]
  created_at timestamptz [not null]
  indexes { (conversation_id, sequence_number) [unique] }
}

Table memories {
  id uuid [pk]
  user_id uuid [not null]
  conversation_id uuid
  memory_type varchar(32) [not null]
  memory_key varchar(255)
  content text [not null]
  metadata jsonb [not null, default: `{}`]
  source_message_id uuid
  importance float
  confidence float
  status varchar(16) [not null, default: 'active']
  last_used_at timestamptz
  expires_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table connectors {
  id bigint [pk, increment]
  tenant_id uuid [not null]
  owner_type varchar(16) [not null]
  owner_user_id uuid
  provider varchar(32) [not null]
  display_name varchar(255) [not null]
  settings jsonb [not null, default: `{}`]
  status varchar(16) [not null, default: 'active']
  created_by_user_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (tenant_id, display_name) [unique] }
}

Table connector_credentials {
  id uuid [pk]
  connector_id bigint [not null, unique]
  credential_type varchar(64) [not null]
  encrypted_payload text [not null]
  expires_at timestamptz
  key_version varchar(64)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table connector_scopes {
  id bigint [pk, increment]
  connector_id bigint [not null]
  scope_type varchar(32)
  scope_value text [not null]
  display_name varchar(255)
  settings jsonb [not null, default: `{}`]
  sync_checkpoint jsonb [not null, default: `{}`]
  sync_schedule jsonb [not null, default: `{}`]
  status varchar(16) [not null, default: 'active']
  last_synced_at timestamptz
  last_indexed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (connector_id, scope_value) [unique] }
}

Table sync_runs {
  id uuid [pk]
  connector_scope_id bigint [not null]
  trigger_type varchar(16) [not null]
  status varchar(16) [not null, default: 'pending']
  discovered_item_count bigint [not null, default: 0]
  processed_item_count bigint [not null, default: 0]
  written_chunk_count bigint [not null, default: 0]
  deleted_item_count bigint [not null, default: 0]
  error_code varchar(128)
  error_message text
  started_at timestamptz
  finished_at timestamptz
  created_at timestamptz [not null]
}

Table items {
  id uuid [pk]
  item_type varchar(16) [not null, note: 'collection | document | file']
  document_kind varchar(32)
  collection_kind varchar(32)
  tenant_id uuid [not null]
  owner_user_id uuid
  connector_id bigint
  connector_scope_id bigint
  external_id text
  external_version text
  etag text
  external_updated_at timestamptz
  parent_item_id uuid
  title text [not null]
  source_url text
  mime_type varchar(255)
  size_bytes bigint
  storage_key text [note: 'Durable key only; bucket/provider come from config']
  content_sha256 varchar(64)
  allowed_principal_tokens text[] [not null]
  denied_principal_tokens text[] [not null]
  metadata jsonb [not null, default: `{}`]
  status varchar(16) [not null, note: 'pending | processing | ready | failed | unsupported | deleted']
  created_by_user_id uuid
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (connector_id, external_id) [unique]
    (tenant_id, status)
    parent_item_id
  }
}

Table item_uploads {
  item_id uuid [pk]
  tenant_id uuid [not null]
  owner_user_id uuid [not null]
  idempotency_key varchar(128) [not null]
  status varchar(16) [not null, note: 'pending | available | failed']
  error_code varchar(128)
  uploaded_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (tenant_id, owner_user_id, idempotency_key) [unique] }
}

Table message_items {
  message_id uuid [not null]
  item_id uuid [not null]
  relation_type varchar(16) [not null]
  position int [not null, default: 0]
  deleted_at timestamptz
  created_at timestamptz [not null]
  indexes { (message_id, item_id, relation_type) [pk] }
}

Table user_principal_tokens {
  tenant_id uuid [not null]
  user_id uuid [not null]
  principal_token varchar(512) [not null]
  connector_id bigint
  deleted_at timestamptz
  created_at timestamptz [not null]
  indexes { (tenant_id, user_id, principal_token) [pk] }
}

Table groups {
  id uuid [pk]
  tenant_id uuid [not null]
  code varchar(64) [not null]
  display_name varchar(255) [not null]
  description text
  principal_token varchar(512) [not null]
  permission_codes text[] [not null]
  status varchar(16) [not null]
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (tenant_id, code) [unique]
    (tenant_id, principal_token) [unique]
  }
}

Table group_memberships {
  group_id uuid [not null]
  user_id uuid [not null]
  status varchar(16) [not null]
  joined_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (group_id, user_id) [pk] }
}

Table access_requests {
  id uuid [pk]
  tenant_id uuid [not null]
  requester_user_id uuid [not null]
  resource_type varchar(32) [not null]
  resource_id varchar(512) [not null]
  access_type varchar(32) [not null]
  reason text
  status varchar(16) [not null]
  reviewed_by_user_id uuid
  review_note text
  reviewed_at timestamptz
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table acl_policies {
  id uuid [pk]
  tenant_id uuid [not null]
  name varchar(255) [not null]
  resource_type varchar(32) [not null, note: 'item']
  resource_id varchar(512) [not null]
  allowed_principal_tokens text[] [not null]
  denied_principal_tokens text[] [not null]
  status varchar(16) [not null]
  created_by_user_id uuid
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table audit_logs {
  id uuid [pk]
  tenant_id uuid [not null]
  actor_user_id uuid
  action varchar(96) [not null]
  resource_type varchar(32) [not null]
  resource_id varchar(512)
  outcome varchar(16) [not null]
  details jsonb [not null, default: `{}`]
  created_at timestamptz [not null]
}

Ref: roles.tenant_id > tenants.id
Ref: tenant_memberships.user_id > users.id
Ref: tenant_memberships.tenant_id > tenants.id
Ref: tenant_memberships.role_id > roles.id
Ref: conversations.user_id > users.id
Ref: messages.conversation_id > conversations.id
Ref: memories.user_id > users.id
Ref: memories.conversation_id > conversations.id
Ref: memories.source_message_id > messages.id
Ref: connectors.tenant_id > tenants.id
Ref: connectors.owner_user_id > users.id
Ref: connectors.created_by_user_id > users.id
Ref: connector_credentials.connector_id - connectors.id
Ref: connector_scopes.connector_id > connectors.id
Ref: sync_runs.connector_scope_id > connector_scopes.id
Ref: items.tenant_id > tenants.id
Ref: items.owner_user_id > users.id
Ref: items.connector_id > connectors.id
Ref: items.connector_scope_id > connector_scopes.id
Ref: items.parent_item_id > items.id
Ref: items.created_by_user_id > users.id
Ref: item_uploads.item_id - items.id
Ref: item_uploads.tenant_id > tenants.id
Ref: item_uploads.owner_user_id > users.id
Ref: message_items.message_id > messages.id
Ref: message_items.item_id > items.id
Ref: user_principal_tokens.tenant_id > tenants.id
Ref: user_principal_tokens.user_id > users.id
Ref: user_principal_tokens.connector_id > connectors.id
Ref: groups.tenant_id > tenants.id
Ref: group_memberships.group_id > groups.id
Ref: group_memberships.user_id > users.id
Ref: access_requests.tenant_id > tenants.id
Ref: access_requests.requester_user_id > users.id
Ref: access_requests.reviewed_by_user_id > users.id
Ref: acl_policies.tenant_id > tenants.id
Ref: acl_policies.created_by_user_id > users.id
Ref: audit_logs.tenant_id > tenants.id
Ref: audit_logs.actor_user_id > users.id
