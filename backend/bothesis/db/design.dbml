// ============================================================================
// BOTHESIS — ENTERPRISE KNOWLEDGE AGENT CORE
//
// PostgreSQL:
//   durable business state + processed chunks
//
// Object Storage:
//   raw file/image/pdf/etc.
//
// Vector DB:
//   embedding + retrieval payload
//
// Redis:
//   ephemeral cache / locking / streaming
//
// Langfuse / OpenTelemetry:
//   LLM / retrieval / tool runtime tracing
// ============================================================================


// ============================================================================
// 1. IDENTITY
// ============================================================================

Table users {
  id uuid [pk, not null]

  email varchar(255) [not null, unique]
  display_name varchar(255)

  status varchar(16) [not null, default: 'active']

  preferences jsonb [not null, default: '{}']

  last_login_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}


Table tenants {
  id uuid [pk, not null]

  code varchar(64) [not null, unique]
  name varchar(255) [not null]

  status varchar(16) [not null, default: 'active']

  settings jsonb [not null, default: '{}']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}


Table roles {
  id uuid [pk, not null]

  tenant_id uuid [not null]

  code varchar(64) [not null]
  display_name varchar(255) [not null]

  // knowledge.read
  // source.manage
  // user.manage
  // admin
  permission_codes text[] [not null, default: '{}']

  status varchar(16) [not null, default: 'active']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, code) [unique]
  }
}


// Optional membership.
//
// No row:
//   standalone user
//
// Has row:
//   enterprise user
//
// user_id PK means:
// one user can belong to maximum one tenant.

Table tenant_memberships {
  user_id uuid [pk, not null]

  tenant_id uuid [not null]
  role_id uuid [not null]

  status varchar(16) [not null, default: 'active']

  joined_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, status)
    role_id
  }
}


// ============================================================================
// 2. CONVERSATION
//
// Conversation belongs to User.
// Not to Tenant.
//
// A conversation may use:
// - personal documents
// - enterprise knowledge
// - both
// ============================================================================

Table conversations {
  id uuid [pk, not null]

  user_id uuid [not null]

  title varchar(512)

  // Rolling compressed conversation context.
  summary text
  summary_updated_at timestamptz

  // Small durable state only.
  //
  // selected documents
  // knowledge filters
  // conversation preferences
  state jsonb [not null, default: '{}']

  status varchar(16) [not null, default: 'active']

  last_message_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, updated_at)
    (user_id, status)
  }
}


// ============================================================================
// 3. MESSAGE
// ============================================================================

Table messages {
  id uuid [pk, not null]

  conversation_id uuid [not null]

  // user | assistant
  role varchar(16) [not null]

  content text [not null]

  // citations / rendering metadata / response annotations
  metadata jsonb [not null, default: '{}']

  sequence_number bigint [not null]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, sequence_number) [unique]
  }
}


// ============================================================================
// 4. MEMORY
//
// Memory belongs to User.
//
// conversation_id/source_message_id are provenance,
// not ownership.
// ============================================================================

Table memories {
  id uuid [pk, not null]

  user_id uuid [not null]

  conversation_id uuid

  // preference
  // fact
  // instruction
  // context
  memory_type varchar(32) [not null]

  // preferred_language
  // response_style
  // current_project
  memory_key varchar(255)

  content text [not null]

  metadata jsonb [not null, default: '{}']

  source_message_id uuid

  importance real
  confidence real

  status varchar(16) [not null, default: 'active']

  last_used_at timestamptz
  expires_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, status)
    (user_id, memory_key)
    (conversation_id, status)
  }
}


// ============================================================================
// 5. CONNECTOR
//
// Connector = authentication/integration instance.
//
// Examples:
// Google Workspace account
// SharePoint tenant
// Confluence account
// S3 credential
// ============================================================================

Table connectors {
  id bigint [pk, increment]

  tenant_id uuid [not null]

  // google_drive
  // sharepoint
  // confluence
  // notion
  // s3
  // website
  provider varchar(32) [not null]

  display_name varchar(255) [not null]

  // Non-secret settings only.
  settings jsonb [not null, default: '{}']

  // Vault / Secrets Manager reference.
  credential_secret_ref varchar(512)

  status varchar(16) [not null, default: 'active']

  created_by_user_id uuid

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, provider, status)
    (tenant_id, display_name) [unique]
  }
}


// ============================================================================
// 6. CONNECTOR SCOPE
//
// Scope = independently synchronized knowledge unit.
//
// Examples:
// Drive folder
// SharePoint site/library
// Confluence space
// S3 prefix
//
// IMPORTANT:
// active_generation = currently active retrieval generation.
// ============================================================================

Table connector_scopes {
  id bigint [pk, increment]

  connector_id bigint [not null]

  scope_value text [not null]

  display_name varchar(255)

  scope_type varchar(32)

  settings jsonb [not null, default: '{}']

  // Provider incremental sync cursor.
  sync_checkpoint jsonb [not null, default: '{}']

  // Optional:
  // {
  //   "cron": "...",
  //   "timezone": "Asia/Ho_Chi_Minh"
  // }
  sync_schedule jsonb [not null, default: '{}']

  // Current successfully activated indexing generation.
  active_generation bigint [not null, default: 0]

  status varchar(16) [not null, default: 'active']

  last_synced_at timestamptz
  last_indexed_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (connector_id, scope_value) [unique]
    (connector_id, status)
  }
}


// ============================================================================
// 7. SYNC RUN
//
// One complete scope synchronization/index generation.
//
// generation is built first.
//
// Only after successful validation:
//
// connector_scopes.active_generation = generation
//
// This provides blue/green-style atomic activation.
// ============================================================================

Table sync_runs {
  id uuid [pk, not null]

  connector_scope_id bigint [not null]

  generation bigint [not null]

  // manual
  // schedule
  // webhook
  // retry
  trigger_type varchar(16) [not null]

  // pending
  // running
  // completed
  // failed
  // cancelled
  status varchar(16) [not null, default: 'pending']

  discovered_document_count bigint [not null, default: 0]
  indexed_document_count bigint [not null, default: 0]
  deleted_document_count bigint [not null, default: 0]

  error_code varchar(128)
  error_message text

  started_at timestamptz
  finished_at timestamptz

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (connector_scope_id, created_at)
    (connector_scope_id, generation)
    (status, created_at)
  }
}


// ============================================================================
// 8. DOCUMENT
//
// Canonical content object.
//
// All are Documents:
//
// upload
// image
// PDF
// DOCX
// Excel
// Google Drive file
// SharePoint file
// Confluence page
// webpage
// generated artifact
//
// No separate File/Attachment entity.
// ============================================================================

Table documents {
  id uuid [pk, not null]


  // --------------------------------------------------------------------------
  // OWNERSHIP
  //
  // Personal:
  //   owner_user_id != NULL
  //   tenant_id     = NULL
  //
  // Enterprise:
  //   tenant_id     != NULL
  //   owner_user_id = NULL
  // --------------------------------------------------------------------------

  owner_user_id uuid
  tenant_id uuid


  // --------------------------------------------------------------------------
  // SOURCE
  //
  // External synced document:
  //   connector_scope_id != NULL
  //
  // Upload/generated:
  //   connector_scope_id = NULL
  // --------------------------------------------------------------------------

  connector_scope_id bigint

  // Generation of the connector scope this snapshot belongs to.
  //
  // This is NOT an independent document version.
  //
  // External:
  //   generation = sync_runs.generation
  //
  // Personal/upload:
  //   NULL
  generation bigint

  // External provider identity:
  // Drive file id / page id / S3 key / ...
  external_id text

  // upload | external | generated
  origin varchar(16) [not null]

  source_url text


  // --------------------------------------------------------------------------
  // SOURCE CHANGE INFORMATION
  //
  // Cheap provider hints only.
  //
  // No content_hash.
  // No chunk_hash.
  // --------------------------------------------------------------------------

  external_version text
  etag text
  external_updated_at timestamptz


  // --------------------------------------------------------------------------
  // DOCUMENT METADATA
  // --------------------------------------------------------------------------

  title text

  mime_type varchar(255)
  size_bytes bigint

  metadata jsonb [not null, default: '{}']


  // --------------------------------------------------------------------------
  // RAW CONTENT
  //
  // Object Storage:
  // documents/<id>/raw
  //
  // Nullable if:
  // - raw bytes live temporarily in PostgreSQL document_blobs
  // - content can be fetched again from provider
  // --------------------------------------------------------------------------

  raw_storage_key text


  // --------------------------------------------------------------------------
  // OPTIONAL DOCUMENT HIERARCHY
  //
  // Only document -> document relationship.
  //
  // Do not use this to model generic folder hierarchy.
  // --------------------------------------------------------------------------

  parent_document_id uuid


  // --------------------------------------------------------------------------
  // MATERIALIZED DOCUMENT ACL
  //
  // Copied directly into Vector DB payload.
  //
  // Examples:
  // google:user:123
  // google:group:finance
  // domain:company.com
  // public
  // --------------------------------------------------------------------------

  allowed_principal_tokens text[] [not null, default: '{}']
  denied_principal_tokens text[] [not null, default: '{}']


  // --------------------------------------------------------------------------
  // RETRIEVAL READINESS
  //
  // none
  // pending
  // indexed
  // failed
  // --------------------------------------------------------------------------

  indexing_status varchar(16) [not null, default: 'none']

  last_indexed_at timestamptz


  // --------------------------------------------------------------------------
  // LIFECYCLE
  //
  // active
  // retired
  // hidden
  // deleted
  // unsupported
  // failed
  // --------------------------------------------------------------------------

  lifecycle_status varchar(16) [not null, default: 'active']

  last_synced_at timestamptz

  deleted_at timestamptz

  // User who explicitly uploaded/created it.
  // NULL for automated connector synchronization.
  created_by_user_id uuid

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]


  indexes {
    // Same source object may exist once in every generation.
    (connector_scope_id, generation, external_id) [unique]

    (owner_user_id, lifecycle_status)

    (tenant_id, lifecycle_status)

    (connector_scope_id, generation, lifecycle_status)

    (connector_scope_id, generation, indexing_status)

    parent_document_id
  }


  Note: '''
  Ownership:

  CHECK (
    (owner_user_id IS NOT NULL AND tenant_id IS NULL)
    OR
    (owner_user_id IS NULL AND tenant_id IS NOT NULL)
  )

  External synced document:

  connector_scope_id IS NOT NULL implies:
  - tenant_id IS NOT NULL
  - owner_user_id IS NULL
  - origin = external
  - external_id IS NOT NULL
  - generation IS NOT NULL

  Upload/generated document:

  connector_scope_id IS NULL implies:
  - generation IS NULL

  Application must guarantee:
  documents.connector_scope_id -> connector_scopes.id
  connector_scopes.connector_id -> connectors.id
  documents.tenant_id = connectors.tenant_id
  '''
}


// ============================================================================
// 9. DOCUMENT CHUNK
//
// PostgreSQL = canonical processed chunk text.
//
// Vector DB = derived retrieval index.
//
// No:
// - content_hash
// - chunk_hash
// - independent chunk revision
//
// Generation is already determined by:
// chunk.document_id -> document.generation
// ============================================================================

Table document_chunks {
  id uuid [pk, not null]

  document_id uuid [not null]

  chunk_index integer [not null]

  content text [not null]

  token_count integer

  start_page_number integer
  end_page_number integer

  heading_path text[]

  metadata jsonb [not null, default: '{}']

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (document_id, chunk_index) [unique]

    document_id
  }
}


// ============================================================================
// 10. MESSAGE <-> DOCUMENT
//
// attachment:
// user supplied document
//
// reference:
// assistant citation/reference
//
// output:
// generated artifact
// ============================================================================

Table message_documents {
  message_id uuid [not null]
  document_id uuid [not null]

  // attachment | reference | output
  relation_type varchar(16) [not null]

  position integer [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, document_id, relation_type) [pk]

    document_id
  }
}


// ============================================================================
// 11. EFFECTIVE ENTERPRISE ACCESS
//
// Precomputed effective principals for a user.
//
// Only enterprise retrieval needs these.
//
// User belongs to max one tenant,
// therefore tenant_id is not duplicated here.
// ============================================================================

Table user_principal_tokens {
  user_id uuid [not null]

  principal_token varchar(512) [not null]

  // Optional provenance.
  connector_id bigint

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, principal_token) [pk]

    user_id

    connector_id
  }
}


// ============================================================================
// 12. OPTIONAL POSTGRES BLOB STORAGE
//
// Infrastructure fallback only.
//
// Use when Object Storage is not available yet.
//
// Not a business File entity.
// ============================================================================

Table document_blobs {
  document_id uuid [pk, not null]

  raw_bytes bytea [not null]

  created_at timestamptz [not null, default: `now()`]
}


// ============================================================================
// RELATIONSHIPS
// ============================================================================


// Identity

Ref: roles.tenant_id > tenants.id

Ref: tenant_memberships.user_id > users.id
Ref: tenant_memberships.tenant_id > tenants.id
Ref: tenant_memberships.role_id > roles.id


// Chat

Ref: conversations.user_id > users.id

Ref: messages.conversation_id > conversations.id

Ref: memories.user_id > users.id
Ref: memories.conversation_id > conversations.id
Ref: memories.source_message_id > messages.id


// Connector

Ref: connectors.tenant_id > tenants.id
Ref: connectors.created_by_user_id > users.id

Ref: connector_scopes.connector_id > connectors.id

Ref: sync_runs.connector_scope_id > connector_scopes.id


// Document

Ref: documents.owner_user_id > users.id
Ref: documents.tenant_id > tenants.id

Ref: documents.connector_scope_id > connector_scopes.id

Ref: documents.parent_document_id > documents.id

Ref: documents.created_by_user_id > users.id

Ref: document_chunks.document_id > documents.id

Ref: message_documents.message_id > messages.id
Ref: message_documents.document_id > documents.id

Ref: document_blobs.document_id - documents.id


// Access

Ref: user_principal_tokens.user_id > users.id
Ref: user_principal_tokens.connector_id > connectors.id
