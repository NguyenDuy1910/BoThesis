# Data boundary for the web client:
# - api: use the real backend values below
# - mock: run the complete review experience without a backend or credentials
NEXT_PUBLIC_BOTHESIS_DATA_MODE=api

# BoThesis agent endpoint. The browser streams directly from this API in api mode.
NEXT_PUBLIC_BOTHESIS_API_URL=http://127.0.0.1:8000

# Temporary request context required by the current backend. Authentication will
# replace these public values when the backend provides an identity API.
NEXT_PUBLIC_BOTHESIS_TENANT_ID=
NEXT_PUBLIC_BOTHESIS_USER_ID=
