# Enterprise Agent endpoint. The browser streams directly from this API.
NEXT_PUBLIC_BOTHESIS_API_URL=http://127.0.0.1:8000

# Google Identity Services client ID. It must match BOTHESIS_GOOGLE_CLIENT_ID
# configured on the backend. OAuth client IDs are public identifiers.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional local-development identity. Do not set these in deployed environments.
# The backend must separately enable BOTHESIS_ALLOW_INSECURE_DEV_IDENTITY.
NEXT_PUBLIC_BOTHESIS_TENANT_ID=
NEXT_PUBLIC_BOTHESIS_USER_ID=
